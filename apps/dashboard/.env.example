# VPS deployment environment for the public dashboard (apps/dashboard/.env).
#
# This file is operator-managed on the VPS only -- it is never committed
# (see .gitignore) and never read by CI/CD directly. The deploy workflow
# (.github/workflows/deploy-dashboard.yml) SSHs in and sources whatever the
# VPS's own apps/dashboard/.env contains; GitHub only holds the SSH
# connection secrets (DASHBOARD_VPS_HOST/USER/PORT/REPO_PATH/SSH_KEY), never
# these host paths. See docs/RUNBOOK.md "One-time VPS prep" for the full
# setup sequence.
#
# Copy this file to apps/dashboard/.env on the VPS and fill in real paths:
#   cp apps/dashboard/.env.example apps/dashboard/.env

# Required. Host path to the private research workspace the one-shot
# projection generator reads at build time. The long-running dashboard
# container never receives this path.
DASHBOARD_STORAGE_HOST_PATH=/var/lib/trading-research/workspace

# Required. Host path to the research artifacts directory.
DASHBOARD_RESEARCH_HOST_PATH=/var/lib/trading-research/research

# Required. Host path to the append-only publication release root. Each
# deploy writes a new release directory here; CURRENT is an atomically
# replaced pointer. A failed generation/validation leaves CURRENT unchanged.
DASHBOARD_PUBLICATION_HOST_ROOT=/var/lib/trading-dashboard/publication

# Optional. Internal Compose DNS URL for the BTC futures dry-run status
# service (ADR-0036). Leave unset if the VPS dry-run worker/status stack
# (deploy/vps/*, Sprint 062 T007) is not deployed on this host yet -- the
# Live Paper / Strategy Execution page renders an honest "not configured"
# state rather than presenting stale data.
# DASHBOARD_STATUS_URL=http://dry-run-status:8090/status

# Optional. Host port Caddy publishes for the shared VPS edge to reach.
# Default 8080 if unset.
# DASHBOARD_HTTP_PORT=8080
